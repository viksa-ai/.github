{
  "schema_version": 1,
  "required_layers": [
    "domain",
    "application",
    "ports",
    "infrastructure",
    "entrypoints",
    "bootstrap"
  ],
  "repositories": [
    {"path": "auth-service", "package": "maeyr_auth"},
    {"path": "builder-service", "package": "maeyr_builder"},
    {"path": "chat-service", "package": "maeyr_chat"},
    {"path": "devspace-service", "package": "maeyr_devspace"},
    {"path": "directory-sync-service", "package": "maeyr_directory_sync"},
    {"path": "headless-service", "package": "maeyr_headless"},
    {
      "path": "hosted-images-service",
      "package": "maeyr_hosted_images",
      "legacy_source_roots": [
        "chrona-builder",
        "chrona-worker-cloud",
        "chrona-worker-secure"
      ]
    },
    {"path": "marketplace-service", "package": "maeyr_marketplace"},
    {"path": "mcp-gateway-service", "package": "maeyr_mcp_gateway"},
    {"path": "pulse-service", "package": "maeyr_pulse"},
    {"path": "scheduler-service", "package": "maeyr_scheduler"},
    {"path": "trace-service", "package": "maeyr_trace"},
    {"path": "volt-engine-service", "package": "maeyr_volt_engine"},
    {"path": "worker-service", "package": "maeyr_worker"}
  ],
  "legacy_source_directories": [
    "api",
    "common",
    "config",
    "constants",
    "dependencies",
    "jobs",
    "mcp_bridge",
    "models",
    "objects",
    "repositories",
    "security",
    "services",
    "tasks",
    "utils",
    "validators"
  ],
  "framework_imports_forbidden_in_domain": [
    "fastapi",
    "starlette",
    "pydantic",
    "motor",
    "pymongo",
    "redis",
    "httpx",
    "requests",
    "temporalio",
    "kubernetes"
  ],
  "resource_constructor_suffixes": [
    "Client",
    "Repository",
    "Service",
    "Gateway",
    "Producer",
    "Consumer",
    "Session",
    "Pool"
  ]
}
